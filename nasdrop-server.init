#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nasdrop-server
DATA_DIR=/mnt/merged/nas
DB_PATH=/mnt/sata1-4/Configs/nasdrop/nasdrop.db
PORT=8881

start_service() {
    mkdir -p /mnt/sata1-4/Configs/nasdrop
    procd_open_instance
    procd_set_param command "$PROG" -port "$PORT" -data "$DATA_DIR" -db "$DB_PATH"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall nasdrop-server 2>/dev/null
}
