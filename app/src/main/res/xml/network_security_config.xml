<?xml version="1.0" encoding="utf-8"?>
<!-- 放行 HTTP 明文传输与自定义证书信任，支持 HTTP WebDAV 直连与内网 NAS 访问 -->
<network-security-config>
	<base-config cleartextTrafficPermitted="true">
		<trust-anchors>
			<certificates src="system" />
			<certificates src="user" />
		</trust-anchors>
	</base-config>
</network-security-config>
